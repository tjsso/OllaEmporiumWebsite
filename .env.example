# Copy this file to .env and edit the values. Never commit your .env file.
# Existing environment variables take precedence, even when they are empty.

PORT=8080
ETSY_LISTINGS_MODE=mock

# Set ETSY_LISTINGS_MODE to etsy and provide these to use live listings.
# ETSY_SHOP_ID=
# ETSY_KEYSTRING=
# ETSY_SHARED_SECRET=
# ETSY_ACCESS_TOKEN=

# Set a strong password to enable product administration.
# ADMIN_PASSWORD=
# For local HTTP development only; never use false on a public server.
# ADMIN_COOKIE_SECURE=false

# PRODUCT_DATA_DIR=./data
